{
  "name": "@cohorly/react-native",
  "version": "1.1.3",
  "description": "Standalone React Native SDK for Cohorly, hosted product analytics (Mixpanel-style). No hard dependency on react-native; works out of the box with in-memory storage and upgrades to AsyncStorage when injected. Ships an autolinked native module for device-info auto-capture.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "ios",
    "android",
    "CohorlyReactNative.podspec",
    "react-native.config.js",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run"
  },
  "keywords": [
    "analytics",
    "product-analytics",
    "cohorly",
    "mixpanel",
    "tracking",
    "react-native"
  ],
  "author": "Giovanne Tarcitano",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gitarcitano/cohorly-js",
    "directory": "packages/sdk-react-native"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react-native": "*",
    "react-native-device-info": "*",
    "@react-native-community/netinfo": "*",
    "expo-application": "*",
    "expo-device": "*"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-device-info": {
      "optional": true
    },
    "@react-native-community/netinfo": {
      "optional": true
    },
    "expo-application": {
      "optional": true
    },
    "expo-device": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "3.2.6"
  }
}
