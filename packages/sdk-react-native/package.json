{
  "name": "@cohorly/react-native",
  "version": "0.1.0",
  "description": "Standalone React Native SDK for Cohorly, local self-hosted product analytics (Mixpanel-style). No hard dependency on react-native; works out of the box with in-memory storage and upgrades to AsyncStorage when injected.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run"
  },
  "keywords": [
    "analytics",
    "product-analytics",
    "cohorly",
    "mixpanel",
    "tracking",
    "react-native"
  ],
  "author": "Giovanne Tarcitano",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gitarcitano/cohorly-js",
    "directory": "packages/sdk-react-native"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
